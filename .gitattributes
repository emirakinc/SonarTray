* text=auto

# Pinned explicitly rather than left to text=auto, because core.autocrlf differs between
# machines (and is on by default on the Windows CI runners). Without this the working tree
# is CRLF on some checkouts and LF on others, and `dotnet format --verify-no-changes` fails
# on whichever one disagrees with .editorconfig.
*.cs        text eol=lf
*.xaml      text eol=lf
*.csproj    text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.manifest  text eol=lf
*.resx      text eol=lf
*.py        text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf

# MSBuild's solution parser rejects an LF .sln ("MSB5010: No file format header found").
*.sln  text eol=crlf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.ico  binary
*.png  binary
