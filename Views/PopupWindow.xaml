<Window x:Class="SonarTray.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SonarTray.Views"
        Title="Sonar Mixer"
        Width="520" Height="326"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" AllowsTransparency="False" WindowStartupLocation="Manual"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,10,14,10">
        <DockPanel>

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="30" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreamMode}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="Sonar Mixer" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;" AutomationProperties.Name="GG"
                        ToolTip="SteelSeries GG'yi aç" Command="{Binding OpenGgCommand}"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE72C;" AutomationProperties.Name="Yenile"
                        ToolTip="Yenile" Command="{Binding RefreshCommand}" Margin="4,0,0,0"/>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Height="30" Margin="0,6,0,0">
                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Windows ile başlat"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Style="{StaticResource FlatButton}" Content="Çıkış" Command="{Binding ExitCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Rows + overlays -->
            <Grid>
                <ItemsControl ItemsSource="{Binding Channels}" IsEnabled="{Binding IsConnected}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ChannelRow/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource OverlayBrush}" CornerRadius="8"
                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Sonar bulunamadı" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="SteelSeries GG çalışıyor mu?" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,10"/>
                        <Button Style="{StaticResource AccentButton}" Content="Yeniden dene"
                                Command="{Binding RetryCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource OverlayBrush}" CornerRadius="8"
                        Visibility="{Binding IsStreamMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Sonar Stream modunda" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bu araç yalnızca Classic modu destekler." Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
