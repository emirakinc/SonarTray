<UserControl x:Class="SonarTray.Views.HotkeySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SonarTray.Resources"
             Focusable="False">
    <DockPanel>

        <Grid DockPanel.Dock="Top" Height="26" Margin="2,0,2,8">
            <TextBlock Text="{x:Static res:Strings.Hotkeys_Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <Button Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Hotkeys_Reset}" FontSize="12"
                    Command="{Binding ResetCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                   Margin="2,8,2,0" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.Hotkeys_Help}"/>

        <!-- Fourteen actions no longer fit the panel, which is sized to the mixer rows. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl ItemsSource="{Binding Bindings}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="2,0,8,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="1" Content="{Binding Display}"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.CaptureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KeyBindButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            <Setter Property="ToolTip" Value="{x:Static res:Strings.Hotkeys_Taken}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                ToolTip="{x:Static res:Strings.Hotkeys_ClearTip}" AutomationProperties.Name="{x:Static res:Strings.Hotkeys_Clear}"
                                Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
