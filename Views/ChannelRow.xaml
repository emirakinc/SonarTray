<UserControl x:Class="SonarTray.Views.ChannelRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44" Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="176"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                   Foreground="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>

        <ToggleButton Grid.Column="2" Style="{StaticResource MuteToggle}" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                      ToolTip="Sustur / sesi aç" VerticalAlignment="Center"/>

        <Slider x:Name="VolumeSlider" Grid.Column="3" AutomationProperties.Name="{Binding Name}" Foreground="{Binding Accent}"
                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SmallChange="0.01" LargeChange="0.05" Margin="6,0" VerticalAlignment="Center">
            <Slider.Style>
                <Style TargetType="Slider" BasedOn="{StaticResource AccentSlider}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Slider.Style>
        </Slider>

        <TextBlock Grid.Column="4" Text="{Binding Percent, StringFormat={}{0}%}" FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="0,0,8,0"/>

        <ComboBox Grid.Column="5" Style="{StaticResource DarkComboBox}" AutomationProperties.Name="{Binding Name}" ItemsSource="{Binding Devices}"
                  SelectedValuePath="Id" SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                  Visibility="{Binding HasDevicePicker, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Center">
            <ComboBox.ToolTip>
                <ToolTip Content="{Binding SelectedDeviceId}"/>
            </ComboBox.ToolTip>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
