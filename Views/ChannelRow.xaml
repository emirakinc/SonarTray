<UserControl x:Class="SonarTray.Views.ChannelRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SonarTray.Resources"
             Focusable="False" Margin="0,0,0,6">
    <Grid Height="46" Background="Transparent">

        <Border CornerRadius="9" Background="{StaticResource CardBrush}"/>
        <Border x:Name="CardHover" CornerRadius="9" Background="{StaticResource CardHoverBrush}" Opacity="0"/>
        <Border x:Name="AccentEdge" Width="3" HorizontalAlignment="Left" Margin="0,11" CornerRadius="0,2,2,0"
                Background="{Binding Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0.35"/>
            </Border.RenderTransform>
        </Border>

        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="168"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>

            <ToggleButton Grid.Column="2" Style="{StaticResource MuteToggle}" AutomationProperties.Name="{Binding Name}"
                          IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{x:Static res:Strings.Panel_MuteToggle}" VerticalAlignment="Center"/>

            <Slider x:Name="VolumeSlider" Grid.Column="3" AutomationProperties.Name="{Binding Name}" Foreground="{Binding Accent}"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SmallChange="0.01" LargeChange="0.05" Margin="8,0" VerticalAlignment="Center">
                <Slider.Style>
                    <Style TargetType="Slider" BasedOn="{StaticResource AccentSlider}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Slider.Style>
            </Slider>

            <TextBlock Grid.Column="4" Text="{Binding Percent, StringFormat={}{0}%}" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="0,0,10,0"/>

            <!-- The row is already tight at 540px, so the profile picker is a 26px button with a
                 popup rather than a second combo box; the slider keeps its width. -->
            <Grid Grid.Column="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ProfileButton" Grid.Column="1" Style="{StaticResource IconButton}"
                        Content="&#xE9E9;" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"
                        ToolTip="{x:Static res:Strings.Profiles_Title}"
                        AutomationProperties.Name="{x:Static res:Strings.Profiles_Title}"
                        Click="OnProfileButtonClick"
                        Visibility="{Binding HasProfilePicker, Converter={StaticResource BoolToVis}}"/>

                <Popup x:Name="ProfilePopup"
                       PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-150">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="178" MaxHeight="240">
                        <Grid>
                            <TextBlock Text="{x:Static res:Strings.Profiles_Loading}" Margin="8,6"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id"
                                     SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{x:Static res:Strings.Profiles_Title}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Padding="4,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <Grid Grid.Column="0" Visibility="{Binding HasDevicePicker, Converter={StaticResource BoolToVis}}">
                <ComboBox Style="{StaticResource DarkComboBox}" AutomationProperties.Name="{Binding Name}"
                          ItemsSource="{Binding Devices}" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                          ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectionBoxItem.Name}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Ellipse Width="7" Height="7" Fill="{StaticResource WarnBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"
                         ToolTip="{x:Static res:Strings.Panel_DeviceMissing}"
                         Visibility="{Binding IsDeviceMissing, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardHover" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Duration="0:0:0.14" To="1"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardHover" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Duration="0:0:0.14" To="0.35"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
