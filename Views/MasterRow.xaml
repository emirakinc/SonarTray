<UserControl x:Class="SonarTray.Views.MasterRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SonarTray.Resources"
             Focusable="False">
    <Grid Height="54" Background="Transparent">

        <!-- Brighter base than a channel card: master is the row you reach for first. -->
        <Border CornerRadius="10" Background="{StaticResource CardHoverBrush}"
                BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1"/>
        <Border x:Name="CardHover" CornerRadius="10" Background="{StaticResource CardHoverBrush}" Opacity="0"/>
        <Border x:Name="AccentEdge" Width="3" HorizontalAlignment="Left" Margin="0,13" CornerRadius="0,2,2,0"
                Background="{Binding Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0.35"/>
            </Border.RenderTransform>
        </Border>

        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                       Foreground="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>

            <ToggleButton Grid.Column="2" Style="{StaticResource MuteToggle}" AutomationProperties.Name="{Binding Name}"
                          IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{x:Static res:Strings.Panel_MuteToggle}" VerticalAlignment="Center"/>

            <Slider x:Name="VolumeSlider" Grid.Column="3" AutomationProperties.Name="{Binding Name}" Foreground="{Binding Accent}"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SmallChange="0.01" LargeChange="0.05" Margin="10,0" VerticalAlignment="Center">
                <Slider.Style>
                    <Style TargetType="Slider" BasedOn="{StaticResource AccentSlider}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Slider.Style>
            </Slider>

            <TextBlock Grid.Column="4" Text="{Binding Percent, StringFormat={}{0}%}" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardHover" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Duration="0:0:0.14" To="1"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardHover" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="AccentEdge" Duration="0:0:0.14" To="0.35"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
