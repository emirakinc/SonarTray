<Window x:Class="SonarTray.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonarTray OSD"
        Width="290" Height="62"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" AllowsTransparency="True" WindowStartupLocation="Manual"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Focusable="False" IsHitTestVisible="False" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Its own layered window, so it gets no DWM backdrop: the surface is painted here. -->
    <Border Background="#F0141B2E" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1"
            CornerRadius="14" Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="Glyph" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                       FontFamily="{StaticResource IconFont}" FontSize="20"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <TextBlock x:Name="NameText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="Value" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>

            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Height="6">
                <Border Background="{StaticResource GlassLineBrush}" CornerRadius="3"/>
                <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"/>
            </Grid>
        </Grid>
    </Border>
</Window>
