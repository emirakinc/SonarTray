<UserControl x:Class="SonarTray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SonarTray.Resources"
             Focusable="False">
    <UserControl.Resources>
        <!-- One settings row: label on the left, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <Grid DockPanel.Dock="Top" Height="26" Margin="2,0,2,8">
            <TextBlock Text="{x:Static res:Strings.Settings_Title}" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Only shown once the language has actually been changed. -->
        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource WarnBrush}" FontSize="11"
                   Margin="2,8,2,0" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.Settings_RestartNeeded}"
                   Visibility="{Binding ShowRestartHint, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>

                <!-- Only present once the background check has actually found something. -->
                <Border Background="{StaticResource CardHoverBrush}" CornerRadius="8" Padding="10,8" Margin="2,0,2,8"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding UpdateText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" FontSize="12"
                                Content="{x:Static res:Strings.Update_Skip}"
                                Command="{Binding SkipUpdateCommand}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" FontSize="12"
                                Content="{x:Static res:Strings.Update_Download}"
                                Command="{Binding DownloadUpdateCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Language -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="176"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                               Text="{x:Static res:Strings.Settings_Language}"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              AutomationProperties.Name="{x:Static res:Strings.Settings_Language}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Keyboard shortcuts -> the hotkey page -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="176"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                               Text="{x:Static res:Strings.Settings_Shortcuts}"/>
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                            Content="{x:Static res:Strings.Hotkeys_Title}"
                            Command="{Binding DataContext.ShowHotkeysCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{StaticResource GlassLineBrush}" Margin="2,6,2,6"/>

                <!-- Volume step for the up/down shortcuts -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                               Text="{x:Static res:Strings.Settings_VolumeStep}"/>
                    <Slider Grid.Column="1" Minimum="1" Maximum="50"
                            Value="{Binding VolumeStepPercent, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_VolumeStep}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding VolumeStepDisplay}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- On-screen display -->
                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              Content="{x:Static res:Strings.Settings_Osd}"
                              IsChecked="{Binding OsdEnabled, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}"
                      IsEnabled="{Binding OsdEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                               Text="{x:Static res:Strings.Settings_OsdDuration}" Margin="18,0,8,0"/>
                    <Slider Grid.Column="1" Minimum="0.3" Maximum="5.0"
                            Value="{Binding OsdSeconds, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_OsdDuration}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding OsdSecondsDisplay}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{StaticResource GlassLineBrush}" Margin="2,6,2,6"/>

                <!-- Tray + channels -->
                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              Content="{x:Static res:Strings.Settings_TrayWheel}"
                              IsChecked="{Binding TrayWheelVolume, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              Content="{x:Static res:Strings.Settings_ShowAux}"
                              IsChecked="{Binding ShowAux, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Style="{StaticResource DarkCheckBox}"
                              Content="{x:Static res:Strings.Settings_CheckUpdates}"
                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{StaticResource GlassLineBrush}" Margin="2,6,2,6"/>

                <Grid Style="{StaticResource SettingRow}">
                    <Button Style="{StaticResource FlatButton}" FontSize="12"
                            Content="{x:Static res:Strings.Settings_OpenLog}"
                            Command="{Binding OpenLogCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
